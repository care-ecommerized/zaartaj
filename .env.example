APP_NAME=Zaartaj
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://zaartaj.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zaartaj
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PAYMENT_GATEWAY=bkash

BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PUBLIC_KEY=

DELIVERY_COURIER=steadfast
DELIVERY_AUTO_DISPATCH=true

STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_WEBHOOK_TOKEN=
STEADFAST_DELIVERY_TYPE=0

# Aramex (test host: https://ws.dev.aramex.net, live: https://ws.aramex.net)
ARAMEX_BASE_URL=https://ws.dev.aramex.net
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_VERSION=v1.0
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_ACCOUNT_PIN=
ARAMEX_ACCOUNT_ENTITY=
ARAMEX_ACCOUNT_COUNTRY_CODE=BD
ARAMEX_SOURCE=24
ARAMEX_ORIGIN_COUNTRY=BD

# Aramex shipper (origin / warehouse) — required on every parcel
ARAMEX_SHIPPER_NAME=
ARAMEX_SHIPPER_COMPANY=
ARAMEX_SHIPPER_PHONE=
ARAMEX_SHIPPER_EMAIL=
ARAMEX_SHIPPER_LINE1=
ARAMEX_SHIPPER_CITY=
ARAMEX_SHIPPER_POSTCODE=
ARAMEX_SHIPPER_COUNTRY_CODE=BD

ARAMEX_PRODUCT_TYPE_DOM=OND
ARAMEX_PRODUCT_TYPE_EXP=PPX
ARAMEX_DEFAULT_WEIGHT=0.5

# --- AED gateways (Stripe / Tap / Tabby / Tamara) ---
# 1 AED = N BDT, used to convert the BDT order total into the AED charge.
FX_AED_TO_BDT=33

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

TAP_SECRET_KEY=
TAP_PUBLISHABLE_KEY=
TAP_WEBHOOK_SECRET=

TABBY_PUBLIC_KEY=
TABBY_SECRET_KEY=
TABBY_MERCHANT_CODE=

TAMARA_BASE_URL=https://api-sandbox.tamara.co
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_TOKEN=
TAMARA_PUBLIC_KEY=
TAMARA_COUNTRY=AE
